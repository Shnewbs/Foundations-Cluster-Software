# Foundations Cluster Runtime 0.0.6a
# Dashboard-managed defaults. Admin UI stays local-only by default; Minecraft joins enter through the Gateway.
cluster.name=Foundations
web.bind=127.0.0.1
web.port=8765
manager.publicUrl=http://127.0.0.1:8765

# First-run bootstrap. NeoForge installs automatically; Minecraft EULA acceptance remains explicit.
template.autoBootstrap=true
template.neoforgeVersion=21.1.250
template.installerBaseUrl=https://maven.neoforged.net/releases/net/neoforged/neoforge
template.requireEula=true
nodeAgent.required=true

# One-click startup baseline.
startup.autoStartWorkers=true
startup.workers=1

# Default worker profile. Memory/JVM settings apply to newly spawned workers.
worker.templateDir=server-template
worker.instancesDir=workers
worker.startPort=25566
worker.bindAddress=127.0.0.1
worker.xms=4G
worker.xmx=12G
worker.extraJvmArgs=-XX:+UseG1GC|-XX:+ParallelRefProcEnabled|-XX:MaxGCPauseMillis=200
worker.evacuationGraceSeconds=10
worker.evacuationMigrationTimeoutSeconds=60
worker.stopGraceSeconds=30
worker.heartbeatTimeoutSeconds=10
worker.registrationTimeoutSeconds=180
worker.retireTimeoutSeconds=1800

# Foundations Session Gateway. 0.0.6a keeps Velocity-backed persistent client sessions for live backend handoff.
# Backend workers bind to worker.bindAddress and are selected at Login Start by the Layer Planner.
gateway.enabled=true
gateway.mode=velocity
gateway.bind=0.0.0.0
gateway.port=25565
gateway.backendHost=127.0.0.1
gateway.motd=Foundations Cluster
gateway.minecraftVersion=1.21.1
gateway.protocolVersion=767
gateway.maxConnections=5000
gateway.connectTimeoutSeconds=5
gateway.handshakeTimeoutSeconds=10
gateway.statusMaxPlayers=100
gateway.velocity.autoBootstrap=true
gateway.velocity.setupTimeoutSeconds=300
gateway.velocity.xms=256M
gateway.velocity.xmx=512M
gateway.velocity.extraJvmArgs=-Dvelocity.max-known-packs=2048
session.ttlSeconds=1800
placement.softMaxMspt=45.0

# 0.0.6a Dynamic Cluster Scaling. Manual remains the default until you enable Automatic.
# Target utilization packs population toward fewer JVMs while keeping headroom for spikes.
scaling.mode=manual
scaling.checkSeconds=5
scaling.minWorkers=1
scaling.maxWorkers=64
scaling.warmWorkers=0
scaling.targetUtilization=0.75
scaling.highPlayersPerWorker=70
scaling.lowPlayersPerWorker=15
scaling.highMspt=45.0
scaling.highCpuPercent=85
scaling.highHeapPercent=85
scaling.scaleUpSustainSeconds=30
scaling.scaleDownSustainSeconds=300
scaling.scaleUpCooldownSeconds=120
scaling.scaleDownCooldownSeconds=120
scaling.scaleDownMigratePlayers=true
scaling.maxConcurrentDrains=4

# Hard host-memory guardrail. totalBudgetGb=0 means auto-detect physical RAM.
# workerReservationGb=0 means derive Xmx + JVM/native overhead.
scaling.memory.enforceHardLimit=true
scaling.memory.totalBudgetGb=0
scaling.memory.systemReserveGb=16
scaling.memory.workerReservationGb=0
scaling.memory.jvmOverheadPercent=20

# One deterministic world-generation baseline for every newly-created worker.
# Existing generated worlds keep their level.dat seed; the Node reports mismatches.
world.seed=AUTO
world.lockSeed=true
world.identity.enforce=true
world.identity.configKeywords=world,worldgen,terrain,biome,generation,climate,tfc

# Dashboard telemetry and alerts.
metrics.retentionSamples=1440
alerts.heapWarnPercent=90
alerts.msptWarn=40.0
alerts.msptCritical=50.0
logs.maxDashboardLines=500

# Dashboard session policy. Passwords use Argon2id; internal tokens are in an encrypted local vault.
security.rememberDays=30
security.sessionHours=12
security.idleHours=12

shutdown.workerWaitSeconds=45

# Population Layer Planner. Layers control population placement; Region Authority below controls persistent ownership metadata.
layer.enabled=true
layer.cellChunks=16
layer.targetPlayers=60
layer.splitPlayers=80
layer.mergePlayers=30
layer.maxLayersPerCell=8
layer.splitMspt=45.0
layer.checkSeconds=5
layer.splitSustainSeconds=30
layer.mergeSustainSeconds=300
layer.leaseSeconds=15
layer.autoSplit=true
layer.autoMerge=true
layer.partyAffinity=true
layer.defaultWorld=foundations
layer.defaultDimension=minecraft:overworld

# Browser console. This is a Foundations/Minecraft console only; no OS shell is exposed.
console.maxCommandLength=2048
console.outputLines=800
console.historyLines=100


# 0.0.4a Region Authority control plane. Regions default to 32x32 chunks.
# Exactly one logical writer lease/epoch exists per region. Vanilla chunk-file write interception/shared storage
# is intentionally NOT enabled yet; the UI reports write fencing as CONTROL-PLANE ONLY.
region.enabled=true
region.regionChunks=32
region.leaseSeconds=15
region.checkSeconds=2
region.recoverySeconds=3
# Preserve the previously-authoritative worker during cluster boot before failover.
region.startupRecoverySeconds=90
region.autoFailover=true

# Cluster-wide lightweight player state plus R7.R6 cluster player profile continuity.
playerState.restoreBasic=true
playerState.retentionDays=30

# Persistent-session MMO transition foundation. Normal region movement NEVER switches the client
# to another Velocity backend, so Minecraft does not enter the visible Reconfiguring/Loading cycle.
# The original backend remains the session anchor while Foundations changes the logical simulation target.
# Actual cross-JVM chunk/entity simulation streaming is the next data-plane stage; until then this is
# control-plane/preload behavior only. The old Velocity switch path is retained only for debugging/emergency use.
handoff.enabled=true
handoff.mode=persistent-session
handoff.legacyVelocityBackendSwitch=false
handoff.timeoutSeconds=20
handoff.preloadRadiusChunks=2
handoff.autoOnCellCrossing=false
handoff.transitionBeltChunks=2

# 0.0.5a.R7 simulation data plane. R7 adds authoritative chunk read-replication
# on top of the bounded manager relay. Replica chunks are caches, never authority.
dataplane.enabled=true
dataplane.pollMillis=50
dataplane.maxQueuePerWorker=2048
dataplane.maxPayloadBytes=16777216
dataplane.maxFramesPerPoll=64
dataplane.frameTtlMillis=10000
dataplane.retryMillis=500
dataplane.remoteBlockPrototype=true
dataplane.chunkReplicationEnabled=true
dataplane.chunkSnapshotRadius=1
dataplane.chunkVerticalRadius=96
dataplane.chunkRequestIntervalMillis=1000
dataplane.chunkCacheTtlMillis=5000
dataplane.maxChunkRequestsPerCycle=2

# R7.R4/R7.R5 restart-durable authoritative persistence journals.
persistence.blockJournalEnabled=true
# R7.R5 generic full BlockEntity persistence. Any vanilla/modded BlockEntity that
# correctly serializes through Minecraft/NeoForge is captured as opaque full NBT.
persistence.blockEntityJournalEnabled=true
# Scan dirty loaded chunks twice per second by default. Only changed BlockEntity
# payloads are committed, and the scan rotates through loaded chunks under budget.
persistence.blockEntityScanIntervalTicks=40
persistence.blockEntityScanBudget=256
# Per BlockEntity encoded payload guard. Increase cautiously for very large storage mods.
persistence.blockEntityMaxPayloadBytes=8388608
# R13: collapse rapidly changing BlockEntity NBT; quiet edits flush quickly, continuously ticking entities checkpoint at most every 5 minutes.
persistence.blockEntityCoalesceMillis=5000
persistence.blockEntityCoalesceMaxMillis=300000
# Vanilla Anvil checkpoint interval for authoritative/replayed mutations.
persistence.checkpointSeconds=30

handoff.maxCommandsPerHeartbeat=128
playerProfile.enabled=true
playerProfile.sharedFiles=playerdata/{uuid}.dat;advancements/{uuid}.json;stats/{uuid}.json

# R7.R6 cluster player continuity and graceful worker evacuation.
# Evacuation grace is separate from final JVM shutdown grace.

# R16: explicit experimental switch. False uses real physical reconfiguration.
gateway.seamless.enabled=false
# Leave migration headroom; reject busy/full/stale destinations.
placement.maxHeapPercent=85

# R18: share vanilla/NeoForge overworld day time and weather across worker JVMs.
world.environment.enabled=true

# Local support ZIP captures. Disabled until configured; no automatic upload.
support.onTestFailure=false
support.intervalMinutes=0
support.keepCount=5
support.maxLogMiB=4
support.maxRuntimeMiB=32
support.maxArchiveMiB=128

# HF11 native authority growth; optional. Restart workers after changing these.
# Temporary view-interest tickets: bounded to 128 chunks/worker, expire after 20s.
dataplane.authorityRandomTicks.enabled=true
dataplane.authorityRandomTicks.ttlMillis=20000
dataplane.authorityRandomTicks.maxChunks=128
